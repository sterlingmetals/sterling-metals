<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Sterling Metals — Premium Stainless Steel Delhi</title>
<meta name="description" content="Sterling Metals supplies Grade 304 & 316 stainless steel sheets, coils, pipes, and industrial orders from Delhi with 24-hour dispatch. Rated 5.0 stars."/>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Playfair+Display:ital,wght@0,700;0,900;1,700;1,900&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --background:#0c0d0f;
    --foreground:#f3f1ec;
    --card:#151618;
    --border:#2a2b2e;
    --muted:#1c1d20;
    --muted-foreground:#9a9a95;
    --primary:#c8965a;
    --primary-foreground:#0c0d0f;
    --accent:#e8b87a;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:transparent;
    color:var(--foreground);
    font-family:'Inter',sans-serif;
    overflow-x:hidden;
  }
  .font-display{font-family:'Playfair Display',serif;}
  .font-mono{font-family:'JetBrains Mono',monospace;}
  .italic{font-style:italic;}
  a{text-decoration:none;color:inherit;}
  ul{list-style:none;}
  img{max-width:100%;display:block;}
  .container{max-width:1280px;margin:0 auto;padding:0 24px;}
  @media(min-width:768px){.container{padding:0 48px;}}

  /* ---------- Scroll progress ---------- */
  .scroll-progress-bar{position:fixed;top:0;left:0;height:3px;background:linear-gradient(90deg,var(--primary),var(--accent));z-index:100;width:0%;transition:width .1s linear;}

  /* ---------- Grid overlay ---------- */
  .grid-lines-overlay{position:fixed;inset:0;pointer-events:none;z-index:1;display:grid;grid-template-columns:repeat(4,1fr);max-width:1280px;margin:0 auto;}
  .grid-line-v{border-left:1px solid rgba(255,255,255,0.04);height:100%;}

  /* ---------- Header ---------- */
  header{position:fixed;top:0;left:0;right:0;z-index:50;transition:all .4s ease;}
  header.scrolled{background:rgba(12,13,15,0.85);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);}
  nav{max-width:1280px;margin:0 auto;padding:0 24px;height:64px;display:flex;align-items:center;justify-content:space-between;}
  @media(min-width:768px){nav{padding:0 48px;height:80px;}}
  .logo-wrap{display:flex;align-items:center;gap:12px;}
  .logo-wrap img{width:36px;height:36px;border-radius:6px;}
  .brand-name{font-family:'Playfair Display',serif;font-weight:700;font-style:italic;font-size:18px;letter-spacing:-0.02em;}
  .diamond{width:10px;height:10px;background:var(--primary);clip-path:polygon(50% 0%,100% 50%,50% 100%,0% 50%);}
  .nav-links{display:none;align-items:center;gap:32px;}
  .nav-links a{font-size:14px;font-weight:500;color:rgba(243,241,236,0.7);transition:color .2s;}
  .nav-links a:hover{color:var(--foreground);}
  @media(min-width:768px){.nav-links{display:flex;} .nav-cta{display:flex !important;} .mobile-toggle{display:none !important;}}
  .btn{display:inline-flex;align-items:center;gap:8px;padding:10px 20px;border-radius:999px;font-weight:600;font-size:14px;transition:all .3s;cursor:pointer;border:none;}
  .btn-primary{background:var(--primary);color:var(--primary-foreground);}
  .btn-primary:hover{background:var(--accent);}
  .btn-outline{border:1px solid var(--border);background:rgba(21,22,24,0.6);color:var(--foreground);}
  .btn-outline:hover{border-color:rgba(200,150,90,0.6);}
  .nav-cta{display:none;align-items:center;gap:12px;}
  .mobile-toggle{width:40px;height:40px;display:flex;align-items:center;justify-content:center;background:none;border:none;color:var(--foreground);cursor:pointer;}
  .mobile-menu{display:none;flex-direction:column;gap:4px;background:rgba(12,13,15,0.97);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);padding:16px 24px 24px;}
  .mobile-menu.open{display:flex;}
  .mobile-menu a{padding:12px 0;font-size:15px;border-bottom:1px solid rgba(255,255,255,0.05);}

  /* ---------- Hero ---------- */
  #hero{position:relative;width:100%;min-height:100svh;display:flex;flex-direction:column;justify-content:flex-end;padding-bottom:80px;overflow:hidden;}
  .hero-bg{position:absolute;inset:0;z-index:0;}
  .hero-bg img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;filter:brightness(0.55);}
  .hero-fade{position:absolute;inset:0;background:linear-gradient(to top,var(--background) 0%,rgba(12,13,15,0.6) 55%,rgba(12,13,15,0.2) 100%);}
  .hero-fade2{position:absolute;inset:0;background:linear-gradient(to right,rgba(12,13,15,0.5),transparent 60%);}

  .spark-field{position:absolute;inset:0;z-index:10;pointer-events:none;overflow:hidden;}
  .spark{position:absolute;bottom:-4px;border-radius:2px;animation:spark-rise linear infinite;}
  @keyframes spark-rise{
    0%{transform:translate(0,0);opacity:0;}
    10%{opacity:1;}
    90%{opacity:0.8;}
    100%{transform:translate(var(--spark-x),-100vh);opacity:0;}
  }

  .status-pill{position:absolute;top:112px;right:24px;z-index:20;}
  @media(min-width:768px){.status-pill{right:56px;}}
  .status-pill .inner{display:flex;align-items:center;gap:10px;padding:8px 16px;border-radius:999px;background:rgba(21,22,24,0.8);backdrop-filter:blur(8px);border:1px solid var(--border);}
  .live-dot{width:8px;height:8px;border-radius:50%;background:#22c55e;animation:pulse-dot 2s infinite;flex-shrink:0;}
  @keyframes pulse-dot{0%,100%{opacity:1;}50%{opacity:0.4;}}

  .hero-grid{position:relative;z-index:20;width:100%;max-width:1280px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:1fr;gap:32px;align-items:end;}
  @media(min-width:768px){.hero-grid{padding:0 48px;grid-template-columns:repeat(12,1fr);}}
  .hero-left{}
  @media(min-width:768px){.hero-left{grid-column:span 7;}}
  .eyebrow{display:flex;align-items:center;gap:12px;margin-bottom:24px;}
  .eyebrow .line{height:1px;width:32px;background:rgba(200,150,90,0.7);}
  .eyebrow span{font-family:'JetBrains Mono',monospace;font-size:12px;text-transform:uppercase;letter-spacing:0.15em;color:var(--primary);}
  h1{font-family:'Playfair Display',serif;font-weight:900;line-height:0.95;letter-spacing:-0.02em;}
  h1 span.line1{display:block;font-size:clamp(3rem,10vw,7.5rem);}
  .shimmer{background:linear-gradient(90deg,var(--primary) 20%,var(--accent) 40%,#fff8ea 50%,var(--accent) 60%,var(--primary) 80%);background-size:200% auto;-webkit-background-clip:text;background-clip:text;color:transparent;animation:shimmer 4s linear infinite;}
  @keyframes shimmer{to{background-position:-200% center;}}
  .hero-desc{margin-top:20px;font-size:18px;font-weight:300;line-height:1.7;color:rgba(243,241,236,0.7);max-width:560px;}
  .hero-btns{display:flex;flex-wrap:wrap;align-items:center;gap:16px;margin-top:32px;}

  .hero-card-wrap{}
  @media(min-width:768px){.hero-card-wrap{grid-column:span 5;grid-column-start:8;}}
  .hero-card{position:relative;overflow:hidden;border-radius:16px;border:1px solid rgba(200,150,90,0.25);background:rgba(21,22,24,0.7);backdrop-filter:blur(20px);padding:28px;}
  .stars{display:flex;gap:2px;color:var(--primary);}
  .stars svg{width:16px;height:16px;}
  .rating-row{display:flex;align-items:center;gap:8px;margin-bottom:20px;}
  .rating-row .score{font-family:'JetBrains Mono',monospace;font-weight:500;}
  .rating-row .of{color:var(--muted-foreground);font-size:12px;margin-left:4px;}
  .stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;border-top:1px solid rgba(255,255,255,0.08);padding-top:20px;margin-bottom:20px;}
  .stat-grid .label{display:block;font-family:'JetBrains Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:0.12em;color:var(--muted-foreground);margin-bottom:4px;}
  .stat-grid .value{font-family:'Playfair Display',serif;font-size:24px;font-weight:700;font-style:italic;}
  .stat-grid .value.accent{color:var(--primary);}
  .addr-row{display:flex;gap:8px;color:var(--muted-foreground);font-size:12px;border-top:1px solid rgba(255,255,255,0.08);padding-top:16px;}
  .addr-row svg{width:14px;height:14px;flex-shrink:0;margin-top:2px;color:var(--primary);}

  .scroll-cue{position:absolute;bottom:24px;left:50%;transform:translateX(-50%);z-index:20;display:flex;flex-direction:column;align-items:center;gap:8px;}
  .scroll-cue span{font-family:'JetBrains Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:0.15em;color:rgba(243,241,236,0.3);}
  .scroll-cue .bar{width:1px;height:40px;background:linear-gradient(to bottom,rgba(200,150,90,0.6),transparent);}

  /* ---------- Section shared ---------- */
  section{position:relative;}
  .section-pad{padding:96px 24px;}
  @media(min-width:768px){.section-pad{padding:128px 48px;}}
  .bg-secondary{background:rgba(17,18,20,0.45);}
  .watermark{position:absolute;top:32px;left:24px;font-family:'Playfair Display',serif;font-weight:900;color:rgba(255,255,255,0.02);pointer-events:none;user-select:none;line-height:1;font-size:clamp(4rem,12vw,9rem);z-index:0;}
  @media(min-width:768px){.watermark{left:48px;}}
  .section-inner{position:relative;z-index:10;max-width:1280px;margin:0 auto;}
  .eyebrow-simple{font-family:'JetBrains Mono',monospace;font-size:12px;text-transform:uppercase;letter-spacing:0.15em;color:var(--primary);display:block;margin-bottom:16px;}
  h2{font-family:'Playfair Display',serif;font-weight:900;font-style:italic;line-height:0.98;letter-spacing:-0.02em;}
  .section-desc{margin-top:16px;color:var(--muted-foreground);font-size:18px;font-weight:300;max-width:560px;}

  /* ---------- Products ---------- */
  .product-grid{display:grid;grid-template-columns:1fr;gap:24px;margin-top:56px;}
  @media(min-width:640px){.product-grid{grid-template-columns:1fr 1fr;gap:32px;}}
  .product-card{position:relative;overflow:hidden;border-radius:16px;background:rgba(21,22,24,0.75);backdrop-filter:blur(6px);border:1px solid var(--border);display:flex;flex-direction:column;transition:transform .3s, border-color .3s;}
  .product-card:hover{transform:translateY(-4px);border-color:rgba(200,150,90,0.4);}
  .product-img{position:relative;height:192px;overflow:hidden;}
  .product-img img{width:100%;height:100%;object-fit:cover;transition:transform .7s;}
  .product-card:hover .product-img img{transform:scale(1.06);}
  .product-img::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,var(--card),rgba(21,22,24,0.3),transparent);}
  .product-tag{position:absolute;top:12px;left:12px;font-family:'JetBrains Mono',monospace;font-size:11px;color:rgba(200,150,90,0.8);background:rgba(12,13,15,0.7);backdrop-filter:blur(4px);padding:4px 10px;border-radius:4px;border:1px solid rgba(200,150,90,0.2);z-index:2;}
  .product-body{padding:24px;display:flex;flex-direction:column;flex:1;}
  .product-title-row{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:12px;}
  .product-title{font-family:'Playfair Display',serif;font-size:20px;font-weight:600;font-style:italic;}
  .product-icon{width:36px;height:36px;border-radius:8px;background:var(--muted);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--primary);}
  .product-icon svg{width:18px;height:18px;}
  .product-desc{font-size:14px;color:var(--muted-foreground);line-height:1.6;margin-bottom:16px;flex:1;}
  .product-spec{font-family:'JetBrains Mono',monospace;font-size:12px;color:rgba(200,150,90,0.7);border-top:1px solid rgba(255,255,255,0.08);padding-top:12px;margin-bottom:16px;}
  .tag-row{display:flex;flex-wrap:wrap;gap:8px;}
  .tag{font-family:'JetBrains Mono',monospace;font-size:11px;padding:4px 10px;border-radius:4px;border:1px solid var(--border);color:var(--muted-foreground);background:rgba(255,255,255,0.02);}

  /* ---------- About ---------- */
  .about-grid{display:grid;grid-template-columns:1fr;gap:56px;align-items:center;}
  @media(min-width:1024px){.about-grid{grid-template-columns:1fr 1fr;}}
  .about-p{color:var(--muted-foreground);font-size:18px;font-weight:300;line-height:1.7;margin-bottom:20px;}
  .about-p.small{font-size:15px;}
  .about-list li{display:flex;align-items:flex-start;gap:10px;font-size:14px;color:rgba(243,241,236,0.8);padding:6px 0;}
  .about-list svg{width:16px;height:16px;color:var(--primary);flex-shrink:0;margin-top:2px;}
  .about-photo{position:relative;height:224px;border-radius:16px;overflow:hidden;border:1px solid var(--border);margin-bottom:24px;}
  .about-photo img{width:100%;height:100%;object-fit:cover;}
  .about-photo::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(21,22,24,0.8),transparent);}
  .about-photo .cap{position:absolute;bottom:16px;left:16px;font-family:'JetBrains Mono',monospace;font-size:11px;color:rgba(200,150,90,0.8);text-transform:uppercase;letter-spacing:0.1em;z-index:2;}
  .rating-card{position:relative;border-radius:16px;border:1px solid var(--border);background:rgba(21,22,24,0.8);backdrop-filter:blur(10px);padding:32px;}
  .big-score{font-family:'Playfair Display',serif;font-weight:900;font-style:italic;font-size:clamp(3rem,8vw,4.5rem);line-height:1;}
  .rating-top{display:flex;align-items:flex-end;gap:16px;margin-bottom:16px;}
  .rating-sub{font-family:'JetBrains Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:0.1em;color:var(--muted-foreground);}
  .rating-note{font-size:14px;font-weight:300;color:var(--muted-foreground);border-top:1px solid rgba(255,255,255,0.08);padding-top:16px;}
  .mini-stats{margin-top:16px;display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;}
  .mini-stat{text-align:center;padding:8px;border-radius:8px;background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.06);}
  .mini-stat .v{display:block;font-family:'Playfair Display',serif;font-size:18px;font-weight:700;font-style:italic;}
  .mini-stat .l{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--muted-foreground);}

  /* ---------- Contact ---------- */
  .contact-wrap{max-width:900px;margin:0 auto;}
  .contact-head{text-align:center;margin-bottom:56px;}
  .contact-head h2{font-size:clamp(2.2rem,5vw,4rem);}
  .contact-head p{margin:16px auto 0;max-width:480px;color:var(--muted-foreground);font-size:18px;font-weight:300;}
  .contact-card{position:relative;border-radius:16px;border:1px solid var(--border);background:rgba(21,22,24,0.8);backdrop-filter:blur(10px);overflow:hidden;box-shadow:0 32px 80px rgba(0,0,0,0.5);}
  .contact-card .hairline{height:1px;background:linear-gradient(90deg,transparent,rgba(200,150,90,0.6),transparent);}
  .contact-body{padding:32px;}
  @media(min-width:768px){.contact-body{padding:48px;}}
  .contact-top{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;margin-bottom:32px;padding-bottom:24px;border-bottom:1px solid rgba(255,255,255,0.08);}
  .contact-top h3{font-family:'Playfair Display',serif;font-size:24px;font-weight:700;font-style:italic;}
  .contact-top .sub{font-family:'JetBrains Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:0.1em;color:var(--muted-foreground);margin-top:4px;}
  .info-row{display:flex;align-items:flex-start;gap:16px;margin-bottom:20px;}
  .info-icon{width:40px;height:40px;border-radius:8px;background:var(--muted);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--primary);}
  .info-icon svg{width:20px;height:20px;}
  .info-label{font-family:'JetBrains Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:0.1em;color:var(--muted-foreground);display:block;margin-bottom:2px;}
  .info-value{font-size:14px;font-weight:500;}
  .open-banner{display:flex;align-items:center;gap:10px;padding:12px;border-radius:12px;background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.06);margin:24px 0;}
  .open-banner span.txt{font-family:'JetBrains Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:0.1em;color:rgba(243,241,236,0.7);}
  .contact-btns{display:flex;flex-direction:column;gap:16px;}
  @media(min-width:640px){.contact-btns{flex-direction:row;}}
  .contact-btns .btn{flex:1;justify-content:center;padding:14px 24px;}

  /* ---------- Footer ---------- */
  footer{border-top:1px solid var(--border);}
  .footer-inner{max-width:1280px;margin:0 auto;padding:32px 24px;display:flex;flex-direction:column;align-items:center;justify-content:space-between;gap:16px;}
  @media(min-width:640px){.footer-inner{flex-direction:row;padding:32px 48px;}}
  .footer-brand{display:flex;align-items:center;gap:10px;}
  .footer-brand img{width:28px;height:28px;border-radius:6px;}
  .footer-links{display:flex;align-items:center;gap:24px;font-size:14px;color:var(--muted-foreground);}
  .footer-links a:hover{color:var(--foreground);}
  .footer-copy{font-size:12px;color:var(--muted-foreground);font-family:'JetBrains Mono',monospace;}

  /* ---------- Reveal on scroll ---------- */
  .reveal{opacity:0;transform:translateY(24px);transition:opacity .7s ease, transform .7s ease;}
  .reveal.in{opacity:1;transform:translateY(0);}
  .diamond-plate{background-image:radial-gradient(rgba(255,255,255,0.015) 1px,transparent 1px);background-size:24px 24px;}
  .metal-texture{background-image:linear-gradient(135deg,rgba(255,255,255,0.015) 25%,transparent 25%,transparent 50%,rgba(255,255,255,0.015) 50%,rgba(255,255,255,0.015) 75%,transparent 75%,transparent);background-size:6px 6px;}
</style>
</head>
<body>
<div id="pageBgPhoto" style="position:fixed;inset:0;z-index:-2;background-image:url('data:image/jpeg;base64,');background-size:cover;background-position:center;background-attachment:fixed;" aria-hidden="true"></div>
<div id="pageBgOverlay" style="position:fixed;inset:0;z-index:-1;background:linear-gradient(180deg, rgba(12,13,15,0.80), rgba(12,13,15,0.88) 40%, rgba(12,13,15,0.93));" aria-hidden="true"></div>

<div class="scroll-progress-bar" id="scrollBar"></div>
<div class="grid-lines-overlay" aria-hidden="true">
  <div class="grid-line-v"></div><div class="grid-line-v"></div><div class="grid-line-v"></div><div class="grid-line-v"></div>
</div>

<header id="siteHeader">
  <nav>
    <div class="logo-wrap">
      <svg width="36" height="36" viewBox="0 0 36 36" style="border-radius:6px;flex-shrink:0;">
        <rect width="36" height="36" rx="6" fill="#c8965a"/>

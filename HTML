      <a href="#products">Products</a>
      <a href="#contact">Contact</a>
    </div>
    <div class="nav-cta">
      <a href="tel:+919932121000" class="btn btn-primary">Call Now</a>
    </div>
    <button class="mobile-toggle" id="mobileToggle" aria-label="Open menu">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="24" height="24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/></svg>
    </button>
  </nav>
  <div class="mobile-menu" id="mobileMenu">
    <a href="#about">About</a>
    <a href="#products">Products</a>
    <a href="#contact">Contact</a>
    <a href="tel:+919932121000">099321 21000</a>
  </div>
</header>

<section id="hero">
  <div class="hero-fade"></div>
  <div class="hero-fade2"></div>
  <div class="spark-field" id="sparkField"></div>

  <div class="status-pill">
    <div class="inner">
      <span class="live-dot"></span>
      <span class="font-mono" style="font-size:12px;text-transform:uppercase;letter-spacing:0.1em;">Open 24 Hours</span>
    </div>
  </div>

  <div class="hero-grid">
    <div class="hero-left">
      <div class="eyebrow"><span class="line"></span><span>Est. 2019 · Delhi, India</span></div>
      <h1>
        <span class="line1">STERLING</span>
        <span class="line1 shimmer">METALS</span>
      </h1>
      <p class="hero-desc">Delhi's most trusted stainless steel distributor — Grade 304, 316 &amp; 202 sheets, coils, pipes, and structural sections. Industrial-grade quality, dispatched in 24 hours.</p>
